:root{
  --bg: #06060a;
  --bg-2: #0b0b14;
  --glass: rgba(18,18,28,0.55);
  --border: rgba(255,255,255,0.08);
  --text: #eae9f2;
  --blob1: 124,92,255; 
  --blob2: 38,217,255; 
  --muted: #8a89a3;
  --accent1: #7c5cff;
  --accent2: #26d9ff;
  --accent3: #ff4fd8;
  --font-display: 'Space Grotesk', sans-serif;
  --font-body: 'Inter', sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
}

@font-face{
  font-family:'Space Grotesk';
  src:local('Space Grotesk');
}

*{ margin:0; padding:0; box-sizing:border-box; }

html,body{
  height:100%;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  overflow:hidden;
}

#bg-canvas{
  position:fixed;
  inset:0;
  z-index:0;
  overflow:hidden;
  background:
    radial-gradient(circle at 20% 20%, rgba(var(--blob1),0.14), transparent 40%),
    radial-gradient(circle at 80% 75%, rgba(var(--blob2),0.10), transparent 45%),
    var(--bg);
  transition: background 1.2s ease;
}
#bg-canvas::before,
#bg-canvas::after{
  content:'';
  position:absolute;
  width:65vmax; height:65vmax;
  border-radius:50%;
  filter: blur(110px);
  pointer-events:none;
  transition: background 1.2s ease;
}
#bg-canvas::before{
  background: radial-gradient(circle, rgba(var(--blob1),.30), transparent 70%);
  top:-25%; left:-20%;
  animation: blobDrift1 28s ease-in-out infinite;
}
#bg-canvas::after{
  background: radial-gradient(circle, rgba(var(--blob2),.24), transparent 70%);
  bottom:-28%; right:-18%;
  animation: blobDrift2 34s ease-in-out infinite;
}
@keyframes blobDrift1{
  0%,100%{ transform: translate(0,0) scale(1); }
  50%{ transform: translate(7%,9%) scale(1.12); }
}
@keyframes blobDrift2{
  0%,100%{ transform: translate(0,0) scale(1); }
  50%{ transform: translate(-9%,-7%) scale(1.1); }
}

body.tod-morning{ --blob1: 255,150,178; --blob2: 255,205,130; } 
body.tod-day{     --blob1: 90,170,255;  --blob2: 56,224,255;  } 
body.tod-evening{ --blob1: 255,132,90;  --blob2: 255,193,90;  } 
body.tod-night{   --blob1: 124,92,255;  --blob2: 38,217,255;  } 

#bg-vignette{
  position:fixed; inset:0; z-index:1; pointer-events:none;
  background: radial-gradient(circle at 50% 42%, transparent 35%, rgba(0,0,0,.45) 100%);
}

#bg-noise{
  position:fixed; inset:0; z-index:1; pointer-events:none;
  opacity:.05;
  mix-blend-mode: overlay;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
}

.wrap{
  position:relative;
  z-index:2;
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:24px;
  perspective:1200px;
}

.card-tilt{
  position:relative;
  width:100%;
  max-width:440px;
  transition: transform .2s ease-out;
  will-change: transform;
  transform-style: preserve-3d;
}
.card-tilt::before{
  content:'';
  position:absolute;
  inset:-3px;
  border-radius:23px;
  background: linear-gradient(135deg, rgba(124,92,255,.22), rgba(38,217,255,.14));
  opacity:0;
  filter: blur(26px);
  transition: opacity .45s ease;
  z-index:-1;
  pointer-events:none;
}
.card-tilt:hover::before{ opacity:.7; }

.card{
  width:100%;
  max-width:440px;
  background:
    linear-gradient(var(--glass), var(--glass)) padding-box,
    linear-gradient(135deg, rgba(255,214,140,.5), rgba(255,235,190,.1) 45%, rgba(255,196,110,.45)) border-box;
  border:1px solid transparent;
  border-radius:20px;
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  padding:38px 30px 30px;
  position:relative;
  box-shadow: 0 24px 70px rgba(0,0,0,0.56), 0 0 0 1px rgba(124,92,255,.06), inset 0 1px 0 rgba(255,255,255,0.05);
  animation: cardRise .9s cubic-bezier(.16,1,.3,1) both;
  animation-play-state: paused;
  overflow:hidden;
}

.card::after{
  content:'';
  position:absolute;
  top:-60%; left:-60%;
  width:35%; height:220%;
  background: linear-gradient(120deg, transparent, rgba(255,255,255,.10), transparent);
  transform: rotate(20deg);
  pointer-events:none;
  z-index:5;
  animation: shimmerSweep 7s ease-in-out infinite;
}
@keyframes shimmerSweep{
  0%, 55%{ left:-60%; opacity:0; }
  62%{ opacity:1; }
  80%{ opacity:1; }
  92%, 100%{ left:140%; opacity:0; }
}

.card::before{
  content:'';
  position:absolute;
  inset:0;
  z-index:6;
  background: radial-gradient(circle 200px at var(--spot-x,50%) var(--spot-y,50%), rgba(255,255,255,.07), transparent 70%);
  opacity:0;
  transition: opacity .35s ease;
  pointer-events:none;
}
.card.spot-active::before{ opacity:1; }

@keyframes cardRise{
  from{ opacity:0; transform: translateY(40px) scale(.93); filter: blur(10px); }
  to{ opacity:1; transform: translateY(0) scale(1); filter: blur(0); }
}

.card > .avatar-zone,
.card > .identity,
.card > .bio,
.card > .discord-activity,
.card > .stats,
.card > .rate-row,
.card > .countdown-row,
.card > .socials,
.card > .music-player,
.card > .divider,
.card > .footer-row{
  opacity:0;
  animation: revealUp .7s cubic-bezier(.2,.8,.2,1) forwards;
  animation-play-state: paused;
}
.card > .avatar-zone{ animation-delay:.25s; }
.card > .identity{ animation-delay:.35s; }
.card > .bio{ animation-delay:.44s; }
.card > .discord-activity{ animation-delay:.5s; }
.card > .stats{ animation-delay:.53s; }
.card > .rate-row{ animation-delay:.58s; }
.card > .countdown-row{ animation-delay:.6s; }
.card > .socials{ animation-delay:.62s; }
.card > .music-player{ animation-delay:.7s; }
.card > .divider{ animation-delay:.76s; }
.card > .footer-row{ animation-delay:.8s; }

body.entered .card,
body.entered .card > .avatar-zone,
body.entered .card > .identity,
body.entered .card > .bio,
body.entered .card > .discord-activity,
body.entered .card > .stats,
body.entered .card > .rate-row,
body.entered .card > .countdown-row,
body.entered .card > .socials,
body.entered .card > .music-player,
body.entered .card > .divider,
body.entered .card > .footer-row{
  animation-play-state: running;
}

@keyframes revealUp{
  from{ opacity:0; transform: translateY(14px); filter: blur(3px); }
  to{ opacity:1; transform: translateY(0); filter: blur(0); }
}

.top-glow{
  position:absolute;
  top:-1px; left:12%; right:12%;
  height:1px;
  background: linear-gradient(90deg, transparent, var(--accent2), var(--accent1), transparent);
  opacity:.8;
}

.banner{
  position:absolute;
  top:0; left:0; right:0;
  height:96px;
  border-radius:20px 20px 0 0;
  background:
    linear-gradient(120deg, rgba(124,92,255,.35), rgba(38,217,255,.25) 50%, rgba(255,79,216,.3));
  background-size:220% 220%;
  animation: drift 10s ease-in-out infinite;
  filter: blur(0.3px);
  mask-image: linear-gradient(to bottom, black, transparent);
  -webkit-mask-image: linear-gradient(to bottom, black, transparent);
}

@keyframes drift{
  0%,100%{ background-position: 0% 30%; }
  50%{ background-position: 100% 70%; }
}

.avatar-zone{
  position:relative;
  width:104px; height:104px;
  margin: 12px auto 14px;
}

.ring{
  position:absolute; inset:-8px;
  border-radius:50%;
  border:1.5px solid rgba(124,92,255,.5);
  animation: pulse 2.4s ease-out infinite;
}
.ring.delay{ animation-delay:1.2s; border-color: rgba(38,217,255,.4); }

@keyframes pulse{
  0%{ transform:scale(0.9); opacity:.9; }
  80%{ opacity:0; }
  100%{ transform:scale(1.5); opacity:0; }
}

.avatar{
  width:100%; height:100%;
  border-radius:50%;
  background: linear-gradient(145deg, var(--accent1), var(--accent2));
  display:flex; align-items:center; justify-content:center;
  font-family: var(--font-display);
  font-size:38px; font-weight:700;
  color:#fff;
  border:3px solid var(--bg-2);
  box-shadow: 0 0 0 2px rgba(124,92,255,.35), 0 14px 40px rgba(124,92,255,.4), 0 6px 16px rgba(0,0,0,.35);
  position:relative;
  z-index:2;
  animation: avatarFloat 4s ease-in-out infinite;
}
@keyframes avatarFloat{
  0%,100%{ transform: translateY(0); }
  50%{ transform: translateY(-4px); }
}

@keyframes skeletonPulse{
  0%{ background-position: 200% 0; }
  100%{ background-position: -200% 0; }
}
.avatar.loading::after{
  content:'';
  position:absolute; inset:0;
  border-radius:50%;
  background: linear-gradient(90deg, rgba(255,255,255,.08) 25%, rgba(255,255,255,.24) 50%, rgba(255,255,255,.08) 75%);
  background-size:200% 100%;
  animation: skeletonPulse 1.6s ease-in-out infinite;
}
.username.loading #usernameText{
  color:transparent;
  border-radius:4px;
  background: linear-gradient(90deg, rgba(255,255,255,.08) 25%, rgba(255,255,255,.2) 50%, rgba(255,255,255,.08) 75%);
  background-size:200% 100%;
  animation: skeletonPulse 1.6s ease-in-out infinite;
}
.handle.loading{
  color:transparent;
  border-radius:4px;
  background: linear-gradient(90deg, rgba(255,255,255,.06) 25%, rgba(255,255,255,.16) 50%, rgba(255,255,255,.06) 75%);
  background-size:200% 100%;
  animation: skeletonPulse 1.6s ease-in-out infinite;
}

.status-dot{
  position:absolute;
  bottom:4px; left:4px;
  width:16px; height:16px;
  border-radius:50%;
  background:#80848e; 
  border:3px solid var(--bg-2);
  z-index:3;
  --status-glow: rgba(128,132,142,.5);
  box-shadow:0 0 10px var(--status-glow);
  animation: statusPulse 2.2s ease-in-out infinite;
  transition: background .35s ease;
}
@keyframes statusPulse{
  0%,100%{ box-shadow:0 0 8px var(--status-glow); }
  50%{ box-shadow:0 0 18px var(--status-glow), 0 0 6px var(--status-glow); }
}

.identity{
  text-align:center;
  margin-bottom:6px;
  position:relative;
  z-index:7;
}

.username{
  font-family: var(--font-display);
  font-size:24px;
  font-weight:700;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:6px;
  letter-spacing:.2px;
}

.badge{
  width:16px; height:16px;
  display:inline-flex; align-items:center; justify-content:center;
}

.handle{
  font-family: var(--font-mono);
  font-size:12.5px;
  color: var(--muted);
}

.handle-row{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:6px;
  margin-top:2px;
}
.copy-btn{
  width:20px; height:20px;
  border-radius:6px;
  border:1px solid var(--border);
  background: rgba(255,255,255,0.04);
  display:flex; align-items:center; justify-content:center;
  cursor:pointer;
  color: var(--muted);
  transition: all .2s ease;
  flex-shrink:0;
}
.copy-btn svg{ width:11px; height:11px; }
.copy-btn:hover{ color:#fff; border-color: rgba(124,92,255,.5); background: rgba(124,92,255,.12); }
.copy-btn:active{ transform: scale(.85); }
.copy-btn.copied{ color:#3ba55d; border-color: rgba(59,165,93,.5); }

.bio{
  text-align:center;
  font-size:14px;
  color:#dddbea;
  line-height:1.75;
  margin:16px 4px 20px;
  min-height:25px;
  position:relative;
  z-index:7;
}

.cursor{
  display:inline-block;
  width:2px; height:14px;
  background: var(--accent2);
  vertical-align:-2px;
  margin-right:2px;
  animation: blink 1s step-end infinite;
}
@keyframes blink{ 50%{ opacity:0; } }

.discord-activity{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  margin:0 auto 16px;
  padding:7px 14px;
  max-width:fit-content;
  background: rgba(124,92,255,0.1);
  border:1px solid rgba(124,92,255,0.25);
  border-radius:999px;
  font-family: var(--font-mono);
  font-size:11.5px;
  color:#c9c3ff;
  animation: activityGlow 2.6s ease-in-out infinite;
}
.discord-activity .act-icon{ font-size:13px; line-height:1; }
@keyframes activityGlow{
  0%,100%{ box-shadow:0 0 0 rgba(124,92,255,0); }
  50%{ box-shadow:0 0 14px rgba(124,92,255,.35); }
}

.stats{
  display:flex;
  justify-content:center;
  gap:18px;
  font-family: var(--font-mono);
  font-size:11px;
  color: var(--muted);
  margin-bottom:22px;
  letter-spacing:.3px;
}
.stats span b{ color: var(--text); font-weight:600; }
.dot-sep{ color:rgba(255,255,255,.15); }

.rate-row{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  font-family: var(--font-mono);
  font-size:11px;
  color: var(--muted);
  margin: -12px 0 20px;
  letter-spacing:.3px;
}
.rate-row button{
  background: rgba(255,255,255,.05);
  border:1px solid var(--border);
  border-radius:8px;
  width:26px; height:26px;
  font-size:13px;
  cursor:pointer;
  display:flex; align-items:center; justify-content:center;
  transition: transform .15s ease, background .2s ease, border-color .2s ease;
}
.rate-row button:hover{ background: rgba(124,92,255,.15); border-color: rgba(124,92,255,.4); }
.rate-row button:active{ transform: scale(.85); }
.rate-row button.picked{ background: rgba(124,92,255,.25); border-color: rgba(124,92,255,.6); }
.rate-row button:disabled{ opacity:.4; cursor:default; }
.rate-row button:disabled:hover{ background: rgba(255,255,255,.05); border-color: var(--border); transform:none; }

.countdown-row{
  text-align:center;
  font-family: var(--font-mono);
  font-size:11px;
  color: var(--muted);
  margin: -12px 0 20px;
  letter-spacing:.3px;
}
.countdown-row b{ color:#ffd68c; font-weight:700; }

.mute-badge{
  display:none;
  position:absolute;
  bottom:-3px; right:-3px;
  width:16px; height:16px;
  border-radius:50%;
  background:#1a1a24;
  border:2px solid var(--bg-2);
  align-items:center; justify-content:center;
  font-size:9px;
  line-height:1;
}
.mp-art.muted .mute-badge{ display:flex; }

.socials{
  display:flex;
  justify-content:center;
  gap:12px;
  margin-bottom:22px;
  flex-wrap:wrap;
}
.socials:empty{ display:none; margin-bottom:0; }

.social{
  width:42px; height:42px;
  border-radius:12px;
  background: rgba(255,255,255,0.04);
  border:1px solid var(--border);
  display:flex; align-items:center; justify-content:center;
  color: var(--muted);
  text-decoration:none;
  transition: transform .25s ease, color .25s ease, border-color .25s ease, background .25s ease;
}
.social svg{ width:18px; height:18px; }
.social:hover{
  transform: translateY(-3px) rotate(-6deg) scale(1.08);
  color:#fff;
  border-color: rgba(124,92,255,.5);
  background: rgba(124,92,255,0.12);
}
.social:active{ transform: scale(.9); }

.social.sc-discord:hover{ background:#5865F2; border-color:#5865F2; color:#fff; box-shadow:0 8px 22px rgba(88,101,242,.45); }
.social.sc-tiktok:hover{ background:#010101; border-color:#010101; color:#fff; box-shadow:0 8px 20px rgba(0,0,0,.5), 0 0 0 1px rgba(37,244,238,.35) inset, 0 0 14px rgba(254,44,85,.35); }
.social.sc-instagram:hover{ background: linear-gradient(45deg,#f9ce34,#ee2a7b 55%,#6228d7); border-color: transparent; color:#fff; box-shadow:0 8px 22px rgba(238,42,123,.45); }
.social.sc-facebook:hover{ background:#1877F2; border-color:#1877F2; color:#fff; box-shadow:0 8px 22px rgba(24,119,242,.45); }
.social.sc-whatsapp:hover{ background:#25D366; border-color:#25D366; color:#fff; box-shadow:0 8px 22px rgba(37,211,102,.45); }
.social.sc-telegram:hover{ background:#26A5E4; border-color:#26A5E4; color:#fff; box-shadow:0 8px 22px rgba(38,165,228,.45); }
.social.sc-twitter:hover{ background:#000; border-color:#000; color:#fff; box-shadow:0 8px 22px rgba(255,255,255,.2); }
.social.sc-youtube:hover{ background:#FF0000; border-color:#FF0000; color:#fff; box-shadow:0 8px 22px rgba(255,0,0,.45); }
.social.sc-snapchat:hover{ background:#FFFC00; border-color:#FFFC00; color:#000; box-shadow:0 8px 22px rgba(255,252,0,.45); }
.social.sc-github:hover{ background:#181717; border-color:#181717; color:#fff; box-shadow:0 8px 22px rgba(255,255,255,.18); }

.social.sc-discord:active{ background:#5865F2; border-color:#5865F2; color:#fff; }
.social.sc-tiktok:active{ background:#010101; border-color:#010101; color:#fff; }
.social.sc-instagram:active{ background: linear-gradient(45deg,#f9ce34,#ee2a7b 55%,#6228d7); border-color:transparent; color:#fff; }
.social.sc-facebook:active{ background:#1877F2; border-color:#1877F2; color:#fff; }
.social.sc-whatsapp:active{ background:#25D366; border-color:#25D366; color:#fff; }
.social.sc-telegram:active{ background:#26A5E4; border-color:#26A5E4; color:#fff; }
.social.sc-twitter:active{ background:#000; border-color:#000; color:#fff; }
.social.sc-youtube:active{ background:#FF0000; border-color:#FF0000; color:#fff; }
.social.sc-snapchat:active{ background:#FFFC00; border-color:#FFFC00; color:#000; }
.social.sc-github:active{ background:#181717; border-color:#181717; color:#fff; }

.divider{
  height:1px;
  background: linear-gradient(90deg, transparent, var(--border), transparent);
  margin: 4px 0 18px;
}

.footer-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  font-family: var(--font-mono);
  font-size:10.5px;
  color: var(--muted);
}
.footer-mark{
  font-family: var(--font-display);
  font-weight:700;
  font-size:13px;
  background: linear-gradient(135deg, var(--accent1), var(--accent2));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  letter-spacing:.5px;
  filter: drop-shadow(0 0 6px rgba(124,92,255,.35));
}
.last-updated{
  text-align:center;
  font-family: var(--font-mono);
  font-size:9.5px;
  color: var(--muted);
  opacity:.55;
  margin-top:8px;
}

.music-player{
  display:flex;
  align-items:center;
  gap:12px;
  background: rgba(255,255,255,0.03);
  border:1px solid var(--border);
  border-radius:14px;
  padding:10px 12px;
  margin-bottom:16px;
  box-shadow: 0 10px 30px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.04);
}

.mp-art{
  width:42px; height:42px;
  border-radius:50%;
  flex-shrink:0;
  position:relative;
  background:
    radial-gradient(circle at center, var(--accent1) 0 7px, #0c0c11 7px 8px, transparent 8px),
    repeating-radial-gradient(circle at center, rgba(255,255,255,.08) 0 2px, transparent 2px 4px),
    linear-gradient(135deg, #16161f, #0b0b10);
  display:flex; align-items:center; justify-content:center;
  box-shadow: 0 4px 14px rgba(124,92,255,.35), inset 0 0 0 1px rgba(255,255,255,.06);
  transition: transform .4s ease;
}
.mp-art.playing{ animation: vinylSpin 3.2s linear infinite; }
@keyframes vinylSpin{
  from{ transform: rotate(0deg); }
  to{ transform: rotate(360deg); }
}

.mp-info{
  flex:1;
  min-width:0;
}
.mp-title{
  font-family: var(--font-body);
  font-size:12.5px;
  font-weight:600;
  color: var(--text);
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.mp-artist{
  font-family: var(--font-mono);
  font-size:10.5px;
  color: var(--muted);
  margin-bottom:6px;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.mp-progress-track{
  height:4px;
  background: rgba(255,255,255,0.08);
  border-radius:999px;
  cursor:pointer;
  position:relative;
  overflow:hidden;
}
.mp-progress-fill{
  position:absolute;
  top:0; right:0;
  height:100%;
  width:0%;
  background: linear-gradient(90deg, var(--accent2), var(--accent1));
  border-radius:999px;
  transition: width .15s linear;
}

.mp-play{
  width:36px; height:36px;
  flex-shrink:0;
  border-radius:50%;
  border:none;
  cursor:pointer;
  background: linear-gradient(135deg, var(--accent1), var(--accent2));
  display:flex; align-items:center; justify-content:center;
  box-shadow: 0 4px 14px rgba(124,92,255,.35);
  transition: transform .15s ease;
}
.mp-play:hover{ transform: scale(1.08); }
.mp-play:active{ transform: scale(.88); }
.mp-play svg{ width:14px; height:14px; fill:#fff; }

.mp-controls{
  display:flex;
  align-items:center;
  gap:4px;
  flex-shrink:0;
}
.mp-nav{
  width:24px; height:24px;
  flex-shrink:0;
  border-radius:50%;
  border:none;
  background:transparent;
  color: var(--muted);
  cursor:pointer;
  display:flex; align-items:center; justify-content:center;
  transition: color .2s ease, transform .15s ease;
}
.mp-nav:hover{ color:#fff; }
.mp-nav:active{ transform: scale(.85); }
.mp-nav svg{ width:15px; height:15px; fill:currentColor; }

/* البلاي ليست بالسكرول */
.mp-queue-panel {
  display:none;
  flex-direction:column;
  gap:4px;
  max-height:180px;
  overflow-y:auto;
  background: rgba(10, 10, 15, 0.75);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(124, 92, 255, 0.25);
  box-shadow: 0 10px 30px rgba(0,0,0,0.6), inset 0 0 15px rgba(255,255,255,0.02);
  border-radius: 16px;
  padding: 10px;
  margin-top: 8px;
  scrollbar-width: thin; 
  scrollbar-color: var(--accent1) rgba(255,255,255,0.05);
}
.mp-queue-panel.show{ display:flex; }
.mp-queue-panel::-webkit-scrollbar { width: 5px; }
.mp-queue-panel::-webkit-scrollbar-track { background: transparent; }
.mp-queue-panel::-webkit-scrollbar-thumb { background: var(--accent2); border-radius: 10px; }

.mp-queue-header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:2px 4px 8px;
  font-size:11px;
  color:var(--muted);
  font-family: var(--font-mono);
  border-bottom:1px solid var(--border);
  margin-bottom:6px;
}
.mp-queue-actions{ display:flex; gap:6px; }
.mp-queue-toggle{
  width:24px; height:24px;
  border-radius:6px;
  border:1px solid var(--border);
  background:rgba(255,255,255,.04);
  color:var(--muted);
  font-size:11.5px;
  cursor:pointer;
  display:flex; align-items:center; justify-content:center;
  transition: all .15s ease;
}
.mp-queue-toggle:hover{ color:#fff; }
.mp-queue-toggle:active{ transform: scale(.85); }
.mp-queue-toggle.active{
  background: rgba(124,92,255,.22);
  border-color: rgba(124,92,255,.55);
  color: var(--accent2);
}

.mp-queue-item {
  display:flex;
  align-items:center;
  gap:10px;
  background: rgba(255,255,255,0.04);
  border: 1px solid transparent;
  border-radius: 10px;
  margin-bottom: 6px;
  padding: 10px 12px;
  cursor:pointer;
  transition: all 0.2s ease;
}
.mp-queue-item:hover {
  background: rgba(124,92,255,0.15);
  border-color: rgba(124,92,255,0.4);
  transform: translateX(-4px); 
}
.mp-queue-item.playing {
  background: linear-gradient(90deg, rgba(124,92,255,0.3), transparent);
  border-right: 3px solid var(--accent2);
}
.mp-queue-num{
  width:18px; flex-shrink:0;
  font-family: var(--font-mono);
  font-size:10.5px;
  color: var(--muted);
  text-align:center;
}
.mp-queue-item.playing .mp-queue-num{ color: var(--accent2); }
.mp-queue-text{ flex:1; min-width:0; }
.mp-queue-title{
  font-size:12px; font-weight:600; color:#fff;
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
}
.mp-queue-artist{
  font-size:10.5px; color: var(--muted);
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
}
.mp-queue-playing-icon{
  flex-shrink:0;
  width:12px; height:12px;
  display:flex; align-items:center; justify-content:center;
}
.mp-queue-playing-icon span{
  width:3px; height:3px; border-radius:50%;
  background: var(--accent2);
  box-shadow: 0 0 6px var(--accent2);
  animation: queueDotPulse 1.2s ease-in-out infinite;
}
@keyframes queueDotPulse{
  0%,100%{ opacity:.4; transform:scale(1); }
  50%{ opacity:1; transform:scale(1.4); }
}

::selection{ background: rgba(124,92,255,.4); }

@media (hover: hover) and (pointer: fine){
  *{ cursor:none !important; }
}
#cursor-glow{
  position:fixed;
  top:0; left:0;
  width:22px; height:22px;
  border-radius:50%;
  background: radial-gradient(circle, rgba(124,92,255,0.9), rgba(38,217,255,0.4) 60%, transparent 70%);
  pointer-events:none;
  z-index:9999;
  mix-blend-mode: screen;
  transform: translate(-50%,-50%);
  transition: width .18s ease, height .18s ease, opacity .2s ease;
}
#cursor-dot{
  position:fixed;
  top:0; left:0;
  width:6px; height:6px;
  border-radius:50%;
  background:#fff;
  pointer-events:none;
  z-index:10000;
  transform: translate(-50%,-50%);
  box-shadow:0 0 8px rgba(255,255,255,.8);
  display:flex; align-items:center; justify-content:center;
  font-size:0;
  transition: width .18s ease, height .18s ease, background .18s ease, font-size .18s ease;
}

#cursor-glow.mode-btn{ width:40px; height:40px; }
#cursor-dot.mode-btn{ width:9px; height:9px; }
#cursor-glow.mode-text{
  width:3px; height:22px;
  border-radius:3px;
  background: linear-gradient(180deg, rgba(124,92,255,.9), rgba(38,217,255,.6));
}
#cursor-dot.mode-text{ width:0; height:0; box-shadow:none; }
#cursor-glow.mode-image{ width:34px; height:34px; opacity:.5; }
#cursor-dot.mode-image{
  width:28px; height:28px;
  background: rgba(18,18,28,.85);
  border:1.5px solid rgba(255,255,255,.3);
  box-shadow:0 0 14px rgba(124,92,255,.5);
  font-size:13px;
}
.cursor-spark{
  position:fixed;
  top:0; left:0;
  width:4px; height:4px;
  border-radius:50%;
  pointer-events:none;
  z-index:9998;
  transform: translate(-50%,-50%);
}

#enterOverlay{
  position:fixed; inset:0; z-index:10050;
  display:flex; align-items:center; justify-content:center;
  background:
    radial-gradient(circle at 50% 40%, rgba(124,92,255,.16), transparent 55%),
    radial-gradient(circle at 80% 80%, rgba(38,217,255,.10), transparent 50%),
    var(--bg);
  cursor:pointer;
  transition: opacity .6s ease, visibility .6s ease;
}
#enterOverlay.hide{
  opacity:0;
  visibility:hidden;
  pointer-events:none;
}
.enter-inner{
  text-align:center;
  animation: enterFloat 3s ease-in-out infinite;
}
@keyframes enterFloat{
  0%,100%{ transform:translateY(0); }
  50%{ transform:translateY(-8px); }
}
.enter-avatar{
  width:92px; height:92px;
  margin:0 auto 20px;
  border-radius:50%;
  background: linear-gradient(145deg, var(--accent1), var(--accent2));
  display:flex; align-items:center; justify-content:center;
  font-family: var(--font-display);
  font-size:34px; font-weight:700; color:#fff;
  box-shadow: 0 0 0 2px rgba(124,92,255,.35), 0 8px 40px rgba(124,92,255,.45);
  position:relative;
}
.enter-avatar::before{
  content:'';
  position:absolute; inset:-10px;
  border-radius:50%;
  border:1.5px solid rgba(124,92,255,.5);
  animation: pulse 2.4s ease-out infinite;
}
.enter-title{
  font-family: var(--font-display);
  font-size:26px; font-weight:700; letter-spacing:.5px;
  margin-bottom:10px;
}
.enter-sub{
  font-family: var(--font-mono);
  font-size:12.5px; color: var(--muted);
  display:flex; align-items:center; justify-content:center; gap:7px;
  letter-spacing:.3px;
}
.enter-sub .pulse-dot{
  width:6px;height:6px;border-radius:50%; background:var(--accent2);
  box-shadow:0 0 8px var(--accent2);
  animation: blink 1.4s ease-in-out infinite;
}

.mp-title-row{
  display:flex; align-items:center; gap:6px;
  min-width:0;
}
.mp-title-row .mp-title{ margin-bottom:0; }

.eq-bars{
  display:none;
  align-items:flex-end;
  gap:2px;
  height:14px;
  flex-shrink:0;
}
.music-player.playing .eq-bars{ display:flex; }
.eq-bars span{
  width:3px;
  height:3px;
  background: linear-gradient(180deg, var(--accent2), var(--accent1));
  border-radius:2px;
  transition: height .06s linear;
}
.eq-bars.fallback span{ animation: eqBounce .9s ease-in-out infinite; }
.eq-bars.fallback span:nth-child(1){ animation-delay:0s; }
.eq-bars.fallback span:nth-child(2){ animation-delay:.2s; }
.eq-bars.fallback span:nth-child(3){ animation-delay:.4s; }
@keyframes eqBounce{
  0%,100%{ height:3px; }
  50%{ height:13px; }
}

.volume-row{
  display:flex;
  align-items:center;
  gap:9px;
  margin: 8px 0 16px;
  padding:0 1px;
}
.vol-btn{
  width:24px; height:24px; flex-shrink:0;
  border:none; background:transparent; color:var(--muted);
  cursor:pointer; display:flex; align-items:center; justify-content:center;
  transition: color .2s ease, transform .15s ease;
}
.vol-btn:hover{ color:#fff; }
.vol-btn:active{ transform: scale(.82); }
.vol-btn svg{ width:15px; height:15px; }
.vol-slider{
  direction: ltr; 
  flex:1;
  -webkit-appearance:none; appearance:none;
  height:4px; border-radius:999px;
  background: rgba(255,255,255,0.08);
  outline:none;
  cursor:pointer;
}
.vol-slider::-webkit-slider-thumb{
  -webkit-appearance:none; appearance:none;
  width:12px; height:12px; border-radius:50%;
  background: linear-gradient(135deg, var(--accent1), var(--accent2));
  box-shadow: 0 0 8px rgba(124,92,255,.6);
  cursor:pointer;
  margin-top:-4px;
}
.vol-slider::-moz-range-thumb{
  width:12px; height:12px; border-radius:50%; border:none;
  background: linear-gradient(135deg, var(--accent1), var(--accent2));
  cursor:pointer;
}
.vol-slider::-moz-range-track{
  height:4px; border-radius:999px; background: rgba(255,255,255,0.08);
}
.vol-time{
  font-family: var(--font-mono);
  font-size:10px; color:var(--muted);
  flex-shrink:0;
  white-space:nowrap;
  min-width:64px;
  text-align:left;
}

.context-menu{
  position:fixed;
  z-index:10090;
  min-width:190px;
  background: rgba(18,18,28,0.92);
  border:1px solid var(--border);
  border-radius:12px;
  padding:6px;
  box-shadow:0 12px 40px rgba(0,0,0,.55);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  display:none;
  flex-direction:column;
  gap:2px;
}
.context-menu.show{ display:flex; }
.context-menu button{
  display:flex;
  align-items:center;
  gap:9px;
  width:100%;
  background:transparent;
  border:none;
  border-radius:8px;
  padding:9px 10px;
  color: var(--text);
  font-family: var(--font-body);
  font-size:12.5px;
  text-align:right;
  cursor:pointer;
  transition: background .15s ease;
}
.context-menu button:hover{ background: rgba(124,92,255,0.16); }
.context-menu button:active{ transform: scale(.98); }
.context-menu .ctx-sep{
  height:1px;
  background: var(--border);
  margin:4px 2px;
}

.game-modal{
  position:fixed; inset:0; z-index:10070;
  display:none;
  align-items:center; justify-content:center;
  background: rgba(0,0,0,.78);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  padding:20px;
}
.game-modal.show{ display:flex; }
.game-box{
  position:relative;
  background: var(--glass);
  border:1px solid var(--border);
  border-radius:18px;
  padding:20px;
  text-align:center;
  box-shadow:0 20px 60px rgba(0,0,0,.6);
  max-width:100%;
}
.game-close{
  position:absolute; top:10px; left:10px;
  width:30px; height:30px;
  border-radius:50%;
  border:none;
  background:rgba(255,255,255,.08);
  color:#fff;
  cursor:pointer;
  font-size:15px;
  line-height:1;
}
.game-close:hover{ background:rgba(255,255,255,.16); }
.game-close:active{ transform: scale(.85); }
.game-score{
  font-family: var(--font-mono);
  font-size:13px;
  color:var(--muted);
  margin-bottom:10px;
}
.game-score b{ color:#fff; }
#gameCanvas{
  background:#0c0c14;
  border-radius:10px;
  display:block;
  touch-action:none;
  max-width:100%;
}
.game-hint{
  font-size:11.5px;
  color:var(--muted);
  margin-top:10px;
  max-width:340px;
}

.confetti-piece{
  position:fixed;
  top:-24px;
  width:8px; height:14px;
  z-index:10060;
  pointer-events:none;
  opacity:.95;
  border-radius:2px;
  animation: confettiFall linear forwards;
}
@keyframes confettiFall{
  0%{ transform: translateY(0) translateX(0) rotate(0deg); }
  100%{ transform: translateY(112vh) translateX(var(--drift)) rotate(560deg); }
}

.falling-emoji {
  position: fixed;
  pointer-events: none;
  z-index: 99999;
  animation: fallDown 3s linear forwards;
}
@keyframes fallDown {
  0% { transform: translateY(-50px) rotate(0deg); opacity: 1; }
  100% { transform: translateY(110vh) rotate(360deg); opacity: 0; }
}

#keyword-trigger-overlay{
  position:fixed; inset:0; z-index:10001;
  display:flex; align-items:center; justify-content:center;
  pointer-events:none;
  opacity:0;
}
#keyword-trigger-overlay.show{
  animation: keywordFlash 1.8s ease forwards;
}
@keyframes keywordFlash{
  0%{ opacity:0; }
  10%{ opacity:1; }
  80%{ opacity:1; }
  100%{ opacity:0; }
}
.keyword-banner{
  font-family: var(--font-display);
  font-size:30px;
  font-weight:700;
  color:#fff;
  padding:16px 30px;
  border-radius:18px;
  background: rgba(18,18,28,0.75);
  border:1px solid rgba(124,92,255,.5);
  box-shadow: 0 0 40px rgba(124,92,255,.55), 0 0 80px rgba(38,217,255,.25);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  display:flex; align-items:center; gap:12px;
  transform: scale(.8);
  animation: keywordPop 1.8s cubic-bezier(.16,1,.3,1) forwards;
  white-space:nowrap;
}
@keyframes keywordPop{
  0%{ transform: scale(.6); }
  15%{ transform: scale(1.08); }
  25%{ transform: scale(1); }
  85%{ transform: scale(1); }
  100%{ transform: scale(.9); }
}
.keyword-particle{
  position:fixed;
  top:0; left:0;
  font-size:20px;
  pointer-events:none;
  z-index:10000;
  will-change: transform, opacity;
}

@keyframes siteShake{
  0%,100%{ transform:translate(0,0); }
  20%{ transform:translate(-6px,3px); }
  40%{ transform:translate(6px,-3px); }
  60%{ transform:translate(-4px,2px); }
  80%{ transform:translate(4px,-2px); }
}
body.site-shake{ animation: siteShake .4s ease; }

@media (prefers-reduced-motion: reduce){
  *, *::before, *::after{
    animation-duration:.01ms !important;
    animation-iteration-count:1 !important;
    transition-duration:.01ms !important;
    scroll-behavior:auto !important;
  }
  .card,
  .card > .avatar-zone,
  .card > .identity,
  .card > .bio,
  .card > .discord-activity,
  .card > .stats,
  .card > .rate-row,
  .card > .countdown-row,
  .card > .socials,
  .card > .music-player,
  .card > .divider,
  .card > .footer-row{
    opacity:1;
    transform:none;
    filter:none;
  }
}

#introLoader{
  position:fixed; inset:0; z-index:10100;
  display:flex; align-items:center; justify-content:center;
  background: var(--bg);
  transition: opacity .4s ease, visibility .4s ease;
}
#introLoader.hide{
  opacity:0;
  visibility:hidden;
  pointer-events:none;
}
.intro-pulse{
  width:60px; height:60px;
  border-radius:50%;
  background: linear-gradient(145deg, var(--accent1), var(--accent2));
  display:flex; align-items:center; justify-content:center;
  font-family: var(--font-display);
  font-weight:700;
  font-size:24px;
  color:#fff;
  box-shadow: 0 0 30px rgba(124,92,255,.5);
  animation: introPulseAnim 1s ease-in-out infinite;
}
@keyframes introPulseAnim{
  0%,100%{ transform: scale(1); opacity:1; }
  50%{ transform: scale(1.18); opacity:.7; }
}

.avatar-zone { position: relative; }
.avatar-zone::after {
  content: ''; position: absolute; inset: -4px; border-radius: 50%;
  background: conic-gradient(transparent 10%, var(--accent1) 40%, var(--accent2) 60%, transparent 90%);
  animation: spinLaser 2.5s linear infinite; z-index: 1; pointer-events: none;
}
.avatar { position: relative; z-index: 2 !important; }
@keyframes spinLaser { 100% { transform: rotate(360deg); } }

#usernameText {
  text-shadow: 0 0 10px rgba(124,92,255,0.8);
  animation: neonPulse 1.5s ease-in-out infinite alternate;
}
@keyframes neonPulse {
  from { text-shadow: 0 0 5px var(--accent1), 0 0 10px var(--accent1); }
  to { text-shadow: 0 0 15px var(--accent2), 0 0 30px var(--accent2); }
}

/* لا نلغي حركة الظهور هنا؛ إلغاؤها يترك الاسم والوصف بشفافية صفر. */
.identity:hover, .bio:hover{ text-shadow:none; }

button:focus-visible,
a:focus-visible,
input:focus-visible{
  outline:2px solid var(--accent2);
  outline-offset:3px;
}

@media (max-width:460px){
  .wrap{ padding:14px; }
  .card{ padding:34px 20px 24px; border-radius:18px; }
  .avatar-zone{ transform:scale(.94); margin-bottom:8px; }
  .username{ font-size:22px; }
  .stats{ gap:10px; font-size:10px; }
  .music-player{ gap:9px; padding:9px 10px; }
}

.custom-tip { position: relative; }
.custom-tip::after {
  content: attr(data-tip);
  position: absolute; bottom: 130%; left: 50%; transform: translateX(-50%) translateY(10px) scale(0.9);
  background: rgba(10,10,15,0.95); border: 1px solid var(--accent1);
  color: #fff; padding: 6px 10px; border-radius: 6px; font-size: 11px; font-family: var(--font-body);
  white-space: nowrap; opacity: 0; pointer-events: none; transition: all 0.2s ease;
  box-shadow: 0 5px 15px rgba(0,0,0,0.5); z-index: 100000;
}
.custom-tip:hover::after { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
