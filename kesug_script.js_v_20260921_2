let countdownInterval = null;
function setupCountdown(dateStr, label){
  const row = document.getElementById('countdownRow');
  if(countdownInterval){ clearInterval(countdownInterval); countdownInterval = null; }
  if(!dateStr){ row.style.display = 'none'; return; }

  const target = new Date(dateStr);
  if(isNaN(target.getTime())){ row.style.display = 'none'; return; }

  document.getElementById('countdownLabel').textContent = label || 'باقي على الموعد:';
  const valueEl = document.getElementById('countdownValue');

  function tick(){
    const diff = target.getTime() - Date.now();
    if(diff <= 0){
      valueEl.textContent = 'وصلنا! 🎉';
      clearInterval(countdownInterval);
      return;
    }
    const days = Math.floor(diff / 86400000);
    const hours = Math.floor((diff % 86400000) / 3600000);
    const mins = Math.floor((diff % 3600000) / 60000);
    if(days > 0) valueEl.textContent = `${days} يوم و${hours} ساعة`;
    else if(hours > 0) valueEl.textContent = `${hours} ساعة و${mins} دقيقة`;
    else valueEl.textContent = `${mins} دقيقة`;
  }
  tick();
  countdownInterval = setInterval(tick, 30000); 
  row.style.display = '';
}

