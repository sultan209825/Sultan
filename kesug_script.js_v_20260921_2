let mx = window.innerWidth/2, my = window.innerHeight/2;

const canvas = document.getElementById('particles');
const ctx = canvas.getContext('2d');
let w,h,particles;

function resize(){
  w = canvas.width = window.innerWidth;
  h = canvas.height = window.innerHeight;
}
window.addEventListener('resize', resize);
resize();

function initParticles(){
  particles = Array.from({length: 60}, () => ({
    x: Math.random()*w,
    y: Math.random()*h,
    r: Math.random()*1.6 + 0.4,
    vx: (Math.random()-0.5)*0.15,
    vy: (Math.random()-0.5)*0.15,
    hue: Math.random() > 0.5 ? '124,92,255' : '38,217,255'
  }));
}
initParticles();

function getSeason(){
  const m = new Date().getMonth(); 
  if(m === 11 || m === 0 || m === 1) return 'winter';
  if(m >= 5 && m <= 7) return 'summer';
  return null; 
}
const season = getSeason();
let weatherParticles = [];
if(season === 'winter'){
  weatherParticles = Array.from({length: 36}, () => ({
    x: Math.random()*w, y: Math.random()*h,
    r: 1.3 + Math.random()*2.2,
    speedY: 0.35 + Math.random()*0.7,
    drift: (Math.random()-0.5)*0.5,
    opacity: 0.25 + Math.random()*0.45,
  }));
} else if(season === 'summer'){
  weatherParticles = Array.from({length: 28}, () => ({
    x: Math.random()*w, y: Math.random()*h,
    r: 0.7 + Math.random()*1.3,
    speed: 0.02 + Math.random()*0.035,
    phase: Math.random()*Math.PI*2,
  }));
}

function loop(){
  ctx.clearRect(0,0,w,h);

  particles.forEach(p => {
    p.x += p.vx; p.y += p.vy;
    if(p.x < 0) p.x = w; if(p.x > w) p.x = 0;
    if(p.y < 0) p.y = h; if(p.y > h) p.y = 0;
  });

  const maxDist = 110;
  for(let i=0;i<particles.length;i++){
    for(let j=i+1;j<particles.length;j++){
      const a = particles[i], b = particles[j];
      const dx = a.x-b.x, dy = a.y-b.y;
      const dist = Math.sqrt(dx*dx+dy*dy);
      if(dist < maxDist){
        const opacity = (1 - dist/maxDist) * 0.16;
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.strokeStyle = `rgba(150,140,255,${opacity})`;
        ctx.lineWidth = 0.6;
        ctx.stroke();
      }
    }
  }

  const mouseDist = 150;
  particles.forEach(p => {
    const dx = p.x - mx, dy = p.y - my;
    const dist = Math.sqrt(dx*dx + dy*dy);
    if(dist < mouseDist){
      const opacity = (1 - dist/mouseDist) * 0.28;
      ctx.beginPath();
      ctx.moveTo(p.x, p.y);
      ctx.lineTo(mx, my);
      ctx.strokeStyle = `rgba(190,180,255,${opacity})`;
      ctx.lineWidth = 0.7;
      ctx.stroke();
    }
  });

  particles.forEach(p => {
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
    ctx.fillStyle = `rgba(${p.hue},0.5)`;
    ctx.fill();
  });

  if(season === 'winter'){
    weatherParticles.forEach(p => {
      p.y += p.speedY;
      p.x += p.drift;
      if(p.y > h){ p.y = -6; p.x = Math.random()*w; }
      if(p.x > w) p.x = 0; if(p.x < 0) p.x = w;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
      ctx.fillStyle = `rgba(255,255,255,${p.opacity})`;
      ctx.fill();
    });
  } else if(season === 'summer'){
    weatherParticles.forEach(p => {
      p.phase += p.speed;
      const op = 0.25 + Math.abs(Math.sin(p.phase)) * 0.5;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
      ctx.fillStyle = `rgba(255,255,255,${op})`;
      ctx.fill();
    });
  }

  requestAnimationFrame(loop);
}
loop();

