function getVisitorInfo(){
  const ua = navigator.userAgent;
  const device  = /Mobi/i.test(ua) ? 'موبايل' : (/Tablet|iPad/i.test(ua) ? 'تابلت' : 'كمبيوتر');
  const os      = /Windows/i.test(ua) ? 'Windows' : /Android/i.test(ua) ? 'Android'
                : /iPhone|iPad/i.test(ua) ? 'iOS' : /Mac OS/i.test(ua) ? 'macOS'
                : /Linux/i.test(ua) ? 'Linux' : 'غير معروف';
  const browser = /Edg\//i.test(ua) ? 'Edge' : /OPR\//i.test(ua) ? 'Opera'
                : /Chrome/i.test(ua) ? 'Chrome' : /Firefox/i.test(ua) ? 'Firefox'
                : /Safari/i.test(ua) ? 'Safari' : 'غير معروف';
  let ref = 'مباشر 🔗';
  try{ ref = document.referrer ? new URL(document.referrer).hostname : 'مباشر 🔗'; }catch(e){}
  let tz = 'غير معروفة';
  try{ tz = Intl.DateTimeFormat().resolvedOptions().timeZone || tz; }catch(e){}
  const lang = navigator.language || 'غير معروفة';
  const screenSize = `${window.screen.width}×${window.screen.height}`;
  const platform = navigator.platform || 'غير معروفة';
  const cores = navigator.hardwareConcurrency ? navigator.hardwareConcurrency + ' نواة' : 'غير معروف';
  const cookiesOn = navigator.cookieEnabled ? 'مفعّلة ✅' : 'معطّلة ⛔';

  let isReturning = false;
  try{ isReturning = !!localStorage.getItem('sultan_seen_before'); localStorage.setItem('sultan_seen_before','1'); }catch(e){}

  return { device, os, browser, ref, tz, lang, screenSize, platform, cores, cookiesOn, isReturning };
}

(function notifyVisit(){
  const NOTIFY_KEY = 'sultan_notified_at';
  const SIX_HOURS = 6 * 60 * 60 * 1000;

  function alreadyNotified(){
    try{
      const last = Number(localStorage.getItem(NOTIFY_KEY) || 0);
      return last && (Date.now() - last) < SIX_HOURS;
    }catch(e){ return false; }
  }
  function markNotified(){
    try{ localStorage.setItem(NOTIFY_KEY, String(Date.now())); }catch(e){}
  }

  async function send(){
    if(alreadyNotified()) return;
    const v = getVisitorInfo();
    markNotified();
    postSiteEvent('visit', Object.assign({}, v, { returning: v.isReturning }));
  }

  setTimeout(send, 2500);
})();

