const cardTilt = document.getElementById('cardTilt');
const isFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

if (isFinePointer) {
  const cardEl = document.querySelector('.card');
  cardEl.addEventListener('mousemove', (e) => {
    const rect = cardEl.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    cardEl.style.setProperty('--spot-x', x + 'px');
    cardEl.style.setProperty('--spot-y', y + 'px');
    cardEl.classList.add('spot-active');
  });
  cardEl.addEventListener('mouseleave', () => {
    cardEl.classList.remove('spot-active');
  });
}

if (isFinePointer) {
  cardTilt.addEventListener('mousemove', (e) => {
    const rect = cardTilt.getBoundingClientRect();
    const relX = (e.clientX - rect.left) / rect.width  - 0.5;
    const relY = (e.clientY - rect.top)  / rect.height - 0.5;
    const rotateY =  relX * 8;
    const rotateX = -relY * 8;
    cardTilt.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
  });
  cardTilt.addEventListener('mouseleave', () => {
    cardTilt.style.transform = 'rotateX(0deg) rotateY(0deg)';
  });
}

let gyroBaseBeta = null, gyroBaseGamma = null;
function handleGyroTilt(e){
  if(e.beta === null || e.gamma === null) return;
  if(gyroBaseBeta === null){ gyroBaseBeta = e.beta; gyroBaseGamma = e.gamma; }
  const dBeta  = e.beta  - gyroBaseBeta;
  const dGamma = e.gamma - gyroBaseGamma;
  const rotateX = Math.max(-8, Math.min(8, -dBeta  / 4));
  const rotateY = Math.max(-8, Math.min(8,  dGamma / 4));
  cardTilt.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
}
function initGyroTilt(){
  window.addEventListener('deviceorientation', handleGyroTilt);
}
function requestGyroPermissionIfNeeded(){
  if (isFinePointer) return; 
  if (typeof DeviceOrientationEvent !== 'undefined' && typeof DeviceOrientationEvent.requestPermission === 'function') {
    DeviceOrientationEvent.requestPermission().then(state => {
      if (state === 'granted') initGyroTilt();
    }).catch(() => {});
  } else if (typeof DeviceOrientationEvent !== 'undefined') {
    initGyroTilt(); 
  }
}

