(function(){
  const TRIGGERS = [
    { word: 'sultan', message: '👑 وصل السلطان!',    particle: '👑', shake: false },
    { word: 'vip',    message: '💎 عضو VIP مميز!',   particle: '💎', shake: false },
    { word: 'party',  message: '🎉 يلا نحتفل!',      particle: '🎉', shake: true  },
  ];
  const GAME_WORD = 'game'; 
  const MAX_LEN = Math.max(...TRIGGERS.map(t => t.word.length), GAME_WORD.length);
  let buffer = '';
  let cooldown = false;

  const overlay = document.createElement('div');
  overlay.id = 'keyword-trigger-overlay';
  document.body.appendChild(overlay);

  function rainEmojis(emoji, count) {
    for (let i = 0; i < count; i++) {
      setTimeout(() => {
        let el = document.createElement('div');
        el.innerText = emoji;
        el.className = 'falling-emoji';
        el.style.fontSize = Math.floor(Math.random() * 25 + 15) + 'px';
        el.style.left = Math.random() * 100 + 'vw';
        el.style.animationDuration = (Math.random() * 2 + 2.5) + 's';
        document.body.appendChild(el);
        setTimeout(() => el.remove(), 4000);
      }, i * 60);
    }
  }

  function trackKeyword(word){
    postTracking({ type: 'keyword', word });
  }

  function triggerKeyword(t){
    if(cooldown) return;
    cooldown = true;
    trackKeyword(t.word);

    overlay.innerHTML = `<div class="keyword-banner">${t.message}</div>`;
    overlay.classList.remove('show');
    void overlay.offsetWidth; 
    overlay.classList.add('show');

    rainEmojis(t.particle, 40); 

    if(t.shake){
      document.body.classList.remove('site-shake');
      void document.body.offsetWidth;
      document.body.classList.add('site-shake');
    }

    setTimeout(() => { overlay.classList.remove('show'); overlay.innerHTML = ''; }, 1800);
    setTimeout(() => { cooldown = false; }, 2500);
  }

  window.addEventListener('keydown', (e) => {
    if(e.ctrlKey || e.metaKey || e.altKey) return;
    if(e.key.length !== 1) return; 
    buffer = (buffer + e.key.toLowerCase()).slice(-MAX_LEN);

    if(buffer.endsWith(GAME_WORD)){
      if(window.openGameModal) window.openGameModal();
      trackKeyword('game');
      buffer = '';
      return;
    }

    for(const t of TRIGGERS){
      if(buffer.endsWith(t.word)){
        triggerKeyword(t);
        buffer = '';
        break;
      }
    }
  });

  window.triggerSultanSurprise = () => triggerKeyword(TRIGGERS[0]); 
})();

