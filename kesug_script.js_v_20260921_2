const THEME_PRESETS = {
  default: { accent1:'#7c5cff', accent2:'#26d9ff', accent3:'#ff4fd8' },
  gold:    { accent1:'#e63946', accent2:'#ffd700', accent3:'#ff9f1c' },
  emerald: { accent1:'#16a34a', accent2:'#06b6d4', accent3:'#a3e635' },
  rose:    { accent1:'#ff4fd8', accent2:'#7c5cff', accent3:'#ff8fab' },
};
function applyTheme(themeName){
  const t = THEME_PRESETS[themeName] || THEME_PRESETS.default;
  const root = document.documentElement.style;
  root.setProperty('--accent1', t.accent1);
  root.setProperty('--accent2', t.accent2);
  root.setProperty('--accent3', t.accent3);
}

function safeExternalUrl(value){
  if(value === '#') return '#';
  try{
    const url = new URL(String(value || ''), window.location.origin);
    return ['http:', 'https:'].includes(url.protocol) ? url.href : '#';
  }catch(e){ return '#'; }
}

function renderSocials(socials, enabled){
  const container = document.getElementById('socialsContainer');
  if(!container) return;
  container.innerHTML = '';
  SOCIAL_ORDER.forEach(key => {
    const icon = SOCIAL_ICON_LIB[key];
    if(!icon) return;
    const isEnabled = !enabled || enabled[key] !== false;
    const url = safeExternalUrl((socials && socials[key]) || '#');
    if(!isEnabled) return; 

    const a = document.createElement('a');
    a.className = 'social ' + icon.cls;
    a.href = url;
    a.title = icon.label;
    a.target = '_blank';
    a.rel = 'noopener';
    a.innerHTML = `<svg viewBox="0 0 24 24" fill="currentColor">${icon.svg}</svg>`;
    container.appendChild(a);
  });
}
renderSocials(window.siteConfig.socials, window.siteConfig.socialsEnabled); 

function formatRelativeTime(isoString){
  const then = new Date(isoString).getTime();
  if(isNaN(then)) return '';
  const diff = Date.now() - then;
  if(diff < 0) return 'قبل لحظات';
  const mins = Math.floor(diff / 60000);
  if(mins < 1) return 'قبل لحظات';
  if(mins < 60) return `قبل ${mins} دقيقة`;
  const hours = Math.floor(mins / 60);
  if(hours < 24) return `قبل ${hours} ساعة`;
  const days = Math.floor(hours / 24);
  if(days === 1) return 'أمس';
  if(days < 30) return `قبل ${days} يوم`;
  const months = Math.floor(days / 30);
  return `قبل ${months} شهر`;
}

