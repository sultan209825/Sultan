(function initHiddenGame(){
  const modal   = document.getElementById('gameModal');
  const closeBtn= document.getElementById('gameClose');
  const canvas  = document.getElementById('gameCanvas');
  const ctx     = canvas.getContext('2d');
  const scoreEl = document.getElementById('gameScore');
  const highScoreEl = document.getElementById('gameHighScore');
  const hintEl  = document.getElementById('gameHint');

  const W = canvas.width, H = canvas.height;
  const groundY = H - 20;

  const HS_KEY = 'sultan_game_highscore';
  let highScore = 0;
  try{ highScore = parseInt(localStorage.getItem(HS_KEY) || '0', 10) || 0; }catch(e){}
  highScoreEl.textContent = highScore;

  function saveHighScoreIfNeeded(finalScore){
    if(finalScore > highScore){
      highScore = finalScore;
      highScoreEl.textContent = highScore;
      try{ localStorage.setItem(HS_KEY, String(highScore)); }catch(e){}
      return true;
    }
    return false;
  }

  let player, obstacles, speed, frame, score, running, rafId;

  function resetGame(){
    player = { x: 30, y: groundY - 20, w: 18, h: 20, vy: 0 };
    obstacles = [];
    speed = 3.2;
    frame = 0;
    score = 0;
    running = true;
    scoreEl.textContent = '0';
    hintEl.textContent = 'اضغطي مسافة أو دوسي على الشاشة للقفز';
  }

  function jump(){
    if(!running){ resetGame(); loop(); return; }
    if(player.y >= groundY - player.h - 0.5){
      player.vy = -7.4;
    }
  }

  function loop(){
    if(!running) return;
    ctx.clearRect(0,0,W,H);

    ctx.strokeStyle = 'rgba(255,255,255,.15)';
    ctx.beginPath();
    ctx.moveTo(0, groundY);
    ctx.lineTo(W, groundY);
    ctx.stroke();

    player.vy += 0.42;
    player.y += player.vy;
    if(player.y > groundY - player.h){
      player.y = groundY - player.h;
      player.vy = 0;
    }
    ctx.fillStyle = '#7c5cff';
    ctx.fillRect(player.x, player.y, player.w, player.h);

    frame++;
    const spawnGap = Math.max(42, 72 - speed*3);
    if(frame % Math.round(spawnGap) === 0){
      const h = 14 + Math.random()*16;
      obstacles.push({ x: W, w: 12, h });
    }

    ctx.fillStyle = '#26d9ff';
    for(let i=obstacles.length-1;i>=0;i--){
      const o = obstacles[i];
      o.x -= speed;
      const oy = groundY - o.h;
      ctx.fillRect(o.x, oy, o.w, o.h);

      const hit = player.x < o.x+o.w && player.x+player.w > o.x &&
                  player.y < oy+o.h && player.y+player.h > oy;
      if(hit){
        running = false;
        const finalScore = Math.floor(score/6);
        const isNewRecord = saveHighScoreIfNeeded(finalScore);
        hintEl.textContent = isNewRecord
          ? `🎉 رقم قياسي جديد: ${finalScore}! — دوسي عشان تعيدي`
          : `خسرتي 😅 نقاطك: ${finalScore} — دوسي عشان تعيدي`;
      }
      if(o.x + o.w < 0) obstacles.splice(i,1);
    }

    score++;
    scoreEl.textContent = Math.floor(score/6);
    speed += 0.0028;

    if(running) rafId = requestAnimationFrame(loop);
  }

  function openGame(){
    modal.classList.add('show');
    resetGame();
    loop();
  }
  function closeGame(){
    running = false;
    if(rafId) cancelAnimationFrame(rafId);
    modal.classList.remove('show');
  }

  closeBtn.addEventListener('click', closeGame);
  modal.addEventListener('click', (e) => { if(e.target === modal) closeGame(); });
  canvas.addEventListener('click', jump);
  canvas.addEventListener('touchstart', (e) => { e.preventDefault(); jump(); }, { passive:false });
  document.addEventListener('keydown', (e) => {
    if(!modal.classList.contains('show')) return;
    if(e.code === 'Space'){ e.preventDefault(); jump(); }
    if(e.key === 'Escape') closeGame();
  });

  window.openGameModal = openGame; 
})();

function playTypeTick(){
  try{
    const ctx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'square';
    osc.frequency.value = 1700 + Math.random()*500; 
    gain.gain.setValueAtTime(0.018, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.02);
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.start();
    osc.stop(ctx.currentTime + 0.025);
  }catch(e){ }
}

const IMPORTANT_CLICK_SEL = '#mpPlay, #enterOverlay';

function playTick(important){
  try{
    const ctx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();

    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.value = important ? 740 : 1100;
    gain.gain.setValueAtTime(important ? 0.07 : 0.05, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + (important ? 0.09 : 0.05));
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.start();
    osc.stop(ctx.currentTime + (important ? 0.1 : 0.06));

    if(important){
      const osc2 = ctx.createOscillator();
      const gain2 = ctx.createGain();
      osc2.type = 'sine';
      osc2.frequency.value = 1110;
      gain2.gain.setValueAtTime(0.04, ctx.currentTime + 0.035);
      gain2.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.13);
      osc2.connect(gain2);
      gain2.connect(ctx.destination);
      osc2.start(ctx.currentTime + 0.035);
      osc2.stop(ctx.currentTime + 0.14);
    }
  }catch(e){ }
}
