(function applyTimeOfDay(){
  const hour = new Date().getHours();
  let cls = 'tod-night';
  if (hour >= 5  && hour < 11) cls = 'tod-morning';
  else if (hour >= 11 && hour < 17) cls = 'tod-day';
  else if (hour >= 17 && hour < 20) cls = 'tod-evening';
  document.body.classList.add(cls);
})();

(function animateTabTitle(){
  const baseTitle = 'SULTAN';
  let idx = 0;
  let deleting = false;
  function step(){
    if(!deleting){
      idx++;
      document.title = baseTitle.slice(0, idx);
      if(idx >= baseTitle.length){
        deleting = true;
        setTimeout(step, 1400); 
        return;
      }
      setTimeout(step, 160);
    } else {
      idx--;
      document.title = baseTitle.slice(0, idx) || '\u200B';
      if(idx <= 0){
        deleting = false;
        setTimeout(step, 500); 
        return;
      }
      setTimeout(step, 90);
    }
  }
  step();
})();

