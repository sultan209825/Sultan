{
  "entities": {
    "SiteConfig": {
      "title": "SiteConfig",
      "description": "Global Sultan Bio and Portfolio Configuration shared across all visitors in real-time",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "Sultan display name",
          "maxLength": 100
        },
        "handle": {
          "type": "string",
          "description": "Sultan unique handle",
          "maxLength": 50
        },
        "bio": {
          "type": "string",
          "description": "Bio description text",
          "maxLength": 500
        },
        "joinYear": {
          "type": "string",
          "description": "Join year",
          "maxLength": 20
        },
        "footerDomain": {
          "type": "string",
          "description": "Domain displayed in footer",
          "maxLength": 100
        },
        "theme": {
          "type": "string",
          "description": "Active site theme ID",
          "maxLength": 50
        },
        "bgEffect": {
          "type": "string",
          "description": "Background effect mode",
          "maxLength": 50
        },
        "countdownDate": {
          "type": "string",
          "description": "Target countdown date ISO string",
          "maxLength": 50
        },
        "countdownLabel": {
          "type": "string",
          "description": "Countdown banner title",
          "maxLength": 200
        },
        "dailyStory": {
          "type": "object",
          "description": "Sultan daily story and mood capsule"
        },
        "discordRadar": {
          "type": "object",
          "description": "Discord live activity radar configuration"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update",
          "maxLength": 50
        }
      },
      "required": ["username", "handle", "bio", "footerDomain", "theme"]
    },
    "SiteStats": {
      "title": "SiteStats",
      "description": "Live visitor and interaction metrics for Sultan Bio",
      "type": "object",
      "properties": {
        "views": {
          "type": "number",
          "description": "Total live site views"
        },
        "upvotes": {
          "type": "number",
          "description": "Total thumbs up ratings"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp",
          "maxLength": 50
        }
      },
      "required": ["views"]
    },
    "SitePresence": {
      "title": "SitePresence",
      "description": "Active online visitor session heartbeat",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "Unique session ID",
          "maxLength": 128
        },
        "device": {
          "type": "string",
          "description": "Client device type",
          "maxLength": 50
        },
        "browser": {
          "type": "string",
          "description": "Client web browser",
          "maxLength": 50
        },
        "os": {
          "type": "string",
          "description": "Client operating system",
          "maxLength": 50
        },
        "country": {
          "type": "string",
          "description": "Visitor country name",
          "maxLength": 100
        },
        "flag": {
          "type": "string",
          "description": "Country flag emoji",
          "maxLength": 20
        },
        "city": {
          "type": "string",
          "description": "Visitor city name",
          "maxLength": 100
        },
        "lastActive": {
          "type": "number",
          "description": "Timestamp in milliseconds of last heartbeat"
        },
        "joinedAt": {
          "type": "number",
          "description": "Timestamp in milliseconds when session started"
        },
        "currentPath": {
          "type": "string",
          "description": "Current URL path or view",
          "maxLength": 100
        }
      },
      "required": ["sessionId", "lastActive"]
    },
    "SiteLog": {
      "title": "SiteLog",
      "description": "Real-time activity log entry for visitor actions and events",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique log ID",
          "maxLength": 128
        },
        "time": {
          "type": "string",
          "description": "Readable time string",
          "maxLength": 50
        },
        "timestamp": {
          "type": "number",
          "description": "Unix timestamp in milliseconds"
        },
        "eventType": {
          "type": "string",
          "description": "Event category",
          "maxLength": 100
        },
        "action": {
          "type": "string",
          "description": "Event action description",
          "maxLength": 200
        },
        "country": {
          "type": "string",
          "description": "Country",
          "maxLength": 100
        },
        "flag": {
          "type": "string",
          "description": "Flag emoji",
          "maxLength": 20
        },
        "city": {
          "type": "string",
          "description": "City",
          "maxLength": 100
        },
        "device": {
          "type": "string",
          "description": "Device type",
          "maxLength": 50
        },
        "os": {
          "type": "string",
          "description": "Operating system",
          "maxLength": 50
        },
        "browser": {
          "type": "string",
          "description": "Browser",
          "maxLength": 50
        },
        "referrer": {
          "type": "string",
          "description": "Referrer URL or label",
          "maxLength": 200
        },
        "duration": {
          "type": "string",
          "description": "Duration text",
          "maxLength": 50
        },
        "details": {
          "type": "string",
          "description": "Additional event details",
          "maxLength": 500
        }
      },
      "required": ["id", "timestamp", "eventType"]
    },
    "LeaderboardScore": {
      "title": "LeaderboardScore",
      "description": "Global Sultan Runner game player leaderboard record for live multiplayer competition",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique score entry ID or player key",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Player display name",
          "maxLength": 100
        },
        "score": {
          "type": "number",
          "description": "Highest score achieved in runner game",
          "minimum": 0
        },
        "date": {
          "type": "string",
          "description": "Human readable date label",
          "maxLength": 50
        },
        "timestamp": {
          "type": "number",
          "description": "Unix timestamp in milliseconds"
        },
        "verified": {
          "type": "boolean",
          "description": "Whether the player is verified as Sultan"
        }
      },
      "required": ["id", "name", "score"]
    }
  },
  "firestore": {
    "/config/{configId}": {
      "schema": "SiteConfig",
      "description": "Global application configuration document synced live across all visitors"
    },
    "/stats/{statId}": {
      "schema": "SiteStats",
      "description": "Public aggregated site counters and interactions"
    },
    "/presence/{sessionId}": {
      "schema": "SitePresence",
      "description": "Live active visitor presence documents with heartbeats"
    },
    "/logs/{logId}": {
      "schema": "SiteLog",
      "description": "Live visitor activity logs shared to admin dashboard"
    },
    "/leaderboard/{entryId}": {
      "schema": "LeaderboardScore",
      "description": "Global competition leaderboard scores synced in real time across all players"
    }
  }
}
